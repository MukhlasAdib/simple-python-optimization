import numpy as np
import numpy.pybridge


def is_point_at_edge_left(
    vertex1: np.ndarray[float, 1], vertex2: np.ndarray[float, 1], point: np.ndarray[float, 1]
) -> bool:
    return (vertex2[0] - vertex1[0]) * (point[1] - vertex1[1]) - (
        vertex2[1] - vertex1[1]
    ) * (point[0] - vertex1[0]) > 0


def is_point_in_polygon(point: np.ndarray[float, 1], polygon: np.ndarray[float, 2]) -> bool:
    wn = 0
    for i in range(len(polygon)):
        vertex1 = polygon[i]
        vertex2 = polygon[(i + 1) % len(polygon)]
        is_crossing_up = vertex1[1] <= point[1] and vertex2[1] > point[1]
        is_crossing_down = vertex1[1] > point[1] and vertex2[1] <= point[1]
        if not is_crossing_up and not is_crossing_down:
            continue
        is_point_at_left = is_point_at_edge_left(vertex1, vertex2, point)
        if is_crossing_up and is_point_at_left:
            wn += 1
        elif is_crossing_down and not is_point_at_left:
            wn -= 1
    return wn != 0


def are_points_in_polygon(polygon: np.ndarray[float, 2], points: np.ndarray[float, 2]) -> np.ndarray[bool, 1]:
    result = np.ones(points.shape[0], dtype=bool)
    for i in range(points.shape[0]):
        result[i] = is_point_in_polygon(points[i], polygon)
    return result


def calc_insides(
    points: np.ndarray[float, 2], polygons: list[np.ndarray[float, 2]]
) -> list[np.ndarray[bool, 1]]:
    return [
        are_points_in_polygon(polygon, points)
        for polygon in polygons
    ]
