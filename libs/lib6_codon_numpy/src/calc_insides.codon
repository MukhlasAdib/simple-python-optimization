import numpy as np
import numpy.pybridge


def are_points_inside_polygon(
    polygon: np.ndarray[float, 2],
    points: np.ndarray[float, 2],
) -> np.ndarray[bool, 1]:
    x, y = points[:, 0][:, None], points[:, 1][:, None]
    x1, y1 = polygon[:, 0], polygon[:, 1]
    x2, y2 = np.roll(x1, -1), np.roll(y1, -1)
    cross = (x2 - x1) * (y - y1) - (y2 - y1) * (x - x1)
    upward = (y1 <= y) & (y2 > y)
    downward = (y1 > y) & (y2 <= y)
    wn = np.sum(upward & (cross > 0), axis=1) - np.sum(downward & (cross < 0), axis=1)
    return wn != 0

def calc_insides(
    polygons: list[np.ndarray[float, 2]],
    points: np.ndarray[float, 2],
) -> list[np.ndarray[bool, 1]]:
    return [
        are_points_inside_polygon(
            polygon, 
            points
        )
        for polygon in polygons
    ]

