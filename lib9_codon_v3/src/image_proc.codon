import numpy as np
import numpy.pybridge


def _computation_loop(
    photo_pixels: np.ndarray[np.uint8, 3],
    logo_pixels: np.ndarray[np.uint8, 3],
    result: np.ndarray[float, 2],
    alpha: float,
) -> np.ndarray[float, 2]:
    @par(collapse=2, schedule='dynamic')
    for i in range(photo_pixels.shape[0]):
        for j in range(photo_pixels.shape[1]):
            r = float(photo_pixels[i, j, 0]) * (1 - alpha) + float(logo_pixels[i, j, 0]) * alpha
            g = float(photo_pixels[i, j, 1]) * (1 - alpha) + float(logo_pixels[i, j, 1]) * alpha
            b = float(photo_pixels[i, j, 2]) * (1 - alpha) + float(logo_pixels[i, j, 2]) * alpha
            gray = 0.299 * r + 0.587 * g + 0.114 * b
            result[i, j] = int(gray)
    return result

def compute_watermark(
    photo_pixels: np.ndarray[np.uint8, 3],
    logo_pixels: np.ndarray[np.uint8, 3],
    alpha: float,
) -> np.ndarray[float, 2]:
    result = np.zeros((photo_pixels.shape[0], photo_pixels.shape[1]), dtype=float)
    result = _computation_loop(photo_pixels, logo_pixels, result, alpha)
    return result
